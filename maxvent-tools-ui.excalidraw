      "lineHeight": 1.25
    },
    {
      "id": "text_1376_34839",
      "type": "text",
      "x": 1014,
      "y": 174,
      "width": 348,
      "height": 52,
      "angle": 0,
      "strokeColor": "#e2e8f0",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1376,
      "version": 1,
      "versionNonce": 1,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "1. Откройте сайт: https://excalidraw.com\n2. Нажмите Меню слева -> Открыть (или перетащите этот файл)\n3. Выделяйте любые кнопки, меняйте текст, двигайте карточки!\n4. Сделайте скриншот и пришлите мне обратно.",
      "fontSize": 10,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 9,
      "containerId": null,
      "originalText": "1. Откройте сайт: https://excalidraw.com\n2. Нажмите Меню слева -> Открыть (или перетащите этот файл)\n3. Выделяйте любые кнопки, меняйте текст, двигайте карточки!\n4. Сделайте скриншот и пришлите мне обратно.",
      "lineHeight": 1.25
    },
